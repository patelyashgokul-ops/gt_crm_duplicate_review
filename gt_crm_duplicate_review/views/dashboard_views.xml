<odoo>
    <record id="view_duplicate_review_dashboard_form" model="ir.ui.view">
        <field name="name">gt.crm.duplicate.dashboard.form</field>
        <field name="model">gt.crm.duplicate.dashboard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Review Dashboard" edit="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh Metrics" class="btn-primary" icon="fa-refresh"/>
                    <field name="recent_scan_status" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>CRM Duplicate Review</h1>
                        <div class="text-muted">Counts include only cases whose two CRM records and company are currently accessible to you.</div>
                    </div>
                    <div class="row g-3 mt-3">
                        <div class="col-12 col-md-4"><button name="action_pending" type="object" class="oe_stat_button w-100"><field name="pending_count" widget="statinfo" string="Pending Reviews"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_strong" type="object" class="oe_stat_button w-100"><field name="strong_count" widget="statinfo" string="Strong Matches"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_possible" type="object" class="oe_stat_button w-100"><field name="possible_count" widget="statinfo" string="Possible Matches"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_approved" type="object" class="oe_stat_button w-100"><field name="merge_approved_count" widget="statinfo" string="Merge Approved"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_merged" type="object" class="oe_stat_button w-100"><field name="merged_count" widget="statinfo" string="Successfully Merged"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_not_duplicate" type="object" class="oe_stat_button w-100"><field name="not_duplicate_count" widget="statinfo" string="Not Duplicate"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_stale" type="object" class="oe_stat_button w-100"><field name="stale_count" widget="statinfo" string="Stale Cases"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_invalid" type="object" class="oe_stat_button w-100"><field name="invalid_count" widget="statinfo" string="Invalid Cases"/></button></div>
                        <div class="col-12 col-md-4"><button name="action_conflicts" type="object" class="oe_stat_button w-100"><field name="conflict_count" widget="statinfo" string="Cases With Conflicts"/></button></div>
                    </div>
                    <div class="alert alert-info mt-4" role="status">Match scores are heuristic rankings, not probabilities or confirmed duplicates. Merge approval always requires a separate explicit confirmation.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_duplicate_review_dashboard_window" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">gt.crm.duplicate.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_duplicate_review_dashboard_form"/>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_duplicate_dashboard" name="Dashboard" parent="menu_duplicate_review" action="action_duplicate_review_dashboard_window" sequence="1" groups="group_duplicate_review_user"/>
</odoo>
