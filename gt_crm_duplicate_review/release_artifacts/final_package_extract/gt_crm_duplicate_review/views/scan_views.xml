<odoo>
    <record id="view_duplicate_scan_list" model="ir.ui.view">
        <field name="name">gt.crm.duplicate.scan.list</field>
        <field name="model">gt.crm.duplicate.scan</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="company_id"/><field name="state" decoration-warning="state in ['partial', 'blocked', 'failed']"/>
                <field name="started_at"/><field name="finished_at"/><field name="last_lead_id"/>
                <field name="records_evaluated"/><field name="candidate_pairs_evaluated"/>
                <field name="cases_created"/><field name="cases_refreshed"/><field name="incomplete_groups"/>
                <field name="error_summary" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_duplicate_scan_history" model="ir.actions.act_window">
        <field name="name">Scan Progress</field>
        <field name="res_model">gt.crm.duplicate.scan</field>
        <field name="view_mode">list</field>
    </record>
    <record id="action_duplicate_skip_group" model="ir.actions.server">
        <field name="name">Skip Blocked Oversized Group</field>
        <field name="model_id" ref="model_gt_crm_duplicate_case"/>
        <field name="group_ids" eval="[(6, 0, [ref('group_duplicate_review_manager')])]"/>
        <field name="state">code</field>
        <field name="code">action = env['gt.crm.duplicate.case'].action_skip_blocked_group()</field>
    </record>
    <menuitem id="menu_duplicate_scan_history" name="Scan History" parent="menu_duplicate_review" action="action_duplicate_scan_history" sequence="40" groups="group_duplicate_review_user"/>
    <menuitem id="menu_duplicate_skip_group" name="Resume Past Oversized Group" parent="menu_duplicate_review" action="action_duplicate_skip_group" sequence="41" groups="group_duplicate_review_manager"/>

    <record id="view_company_form_duplicate_review_scan" model="ir.ui.view">
        <field name="name">res.company.form.duplicate.review.scan</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="duplicate_review_scan_enabled" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
